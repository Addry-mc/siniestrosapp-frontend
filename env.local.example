# ──────────────────────────────────────────────────────────────────
# Firebase Configuration for frontend2 (Vite)
# Copy this file, rename it to .env.local, and fill in your values.
# .env.local is .gitignored — NEVER commit real credentials.
# ──────────────────────────────────────────────────────────────────

# Firebase project credentials
# Get these from: Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend API URL (optional — leave empty to use Vite proxy in dev)
# In production, set this to your backend origin, e.g.: https://api.tuapp.com
VITE_API_URL=
